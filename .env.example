# .env.example — copy to .env and fill in values before running seal-secrets.sh
# .env is gitignored — never commit it with real values.

TRUENAS_API_KEY=
CLOUDFLARE_API_TOKEN=
IMMICH_DB_PASSWORD=
IMMICH_SECRET_KEY=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_PASSWORD=

# Nextcloud (optional — only needed to re-seal the Nextcloud secret)
# NEXTCLOUD_POSTGRES_PASSWORD=
# NEXTCLOUD_ADMIN_PASSWORD=

# arr-stack exportarr metrics — get API keys from each app's Settings > General
ARR_SONARR_API_KEY=
ARR_RADARR_API_KEY=
ARR_LIDARR_API_KEY=
ARR_PROWLARR_API_KEY=
ARR_BAZARR_API_KEY=
ARR_QBITTORRENT_USER=
ARR_QBITTORRENT_PASS=
